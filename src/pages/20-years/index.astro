---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import SaleBanner from '../../components/SaleBanner.astro';
import Story from '../../components/Story.astro';
import Watch from '../../components/Watch.astro';
import Growing from '../../components/Growing.astro';
import Gallery from '../../components/Gallery.astro';
import Sale from '../../components/Sale.astro';
import Reviews from '../../components/Reviews.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ogImage from '../../assets/story/everett-sandra-blossoms.jpg';
---

<Layout
	title="Garden Gate Nursery: 20 Years"
	description="Celebrating 20 years of Garden Gate Nursery: our story, people, and high-quality container trees for the Pacific Northwest."
	image={ogImage}
	imageAlt="Everett and Sandra among blossoming trees at Garden Gate Nursery"
>
	<Hero />
	<SaleBanner />
	<main>
		<Story />
		<Watch />
		<Growing />
		<Gallery />
		<Sale />
		<Reviews />
	</main>
	<SiteFooter />
</Layout>
