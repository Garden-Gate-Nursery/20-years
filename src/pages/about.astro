---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SHOP_URL } from '../constants/site';
import aboutImage from '../assets/story/fall-garden-gate.jpg';
import familyImage from '../assets/story/everett-sandra-blossoms.jpg';
import Reviews from '../components/Reviews.astro';
---

<Layout
	title="Pasco Plant Nursery | About Garden Gate | Tri-Cities"
	description="Garden Gate is a family plant nursery in Pasco, Washington, growing container shade and ornamental trees for Tri-Cities homeowners and landscapes."
>
	<SiteHeader />
	<main>
		<section class="section about-hero">
			<div class="section__inner about-hero__inner reveal">
				<div class="about-hero__copy">
					<p class="section__eyebrow">About us</p>
					<h1>A family nursery for Tri-Cities yards</h1>
					<p class="section__lead">
						Garden Gate Nursery grows high-quality container trees in Pasco so local homeowners
						can plant trees that thrive in the Columbia Basin.
					</p>
				</div>
				<figure class="about-hero__figure">
					<Image
						src={aboutImage}
						alt="Garden Gate Nursery sign among trees in fall color"
						widths={[600, 900, 1200]}
						sizes="(max-width: 900px) 100vw, 48vw"
						quality={80}
						class="about-hero__img"
						loading="eager"
					/>
				</figure>
			</div>
		</section>

		<section class="section about-story">
			<div class="section__inner about-story__inner">
				<div class="about-story__copy reveal">
					<p class="section__eyebrow">Our story</p>
					<h2>From hay fields to tree rows</h2>
					<p>
						Everett and Sandra Wray started Garden Gate with a simple need: supply Tri-Cities
						landscapes with healthy trees. What began as a few rows in Eastern Washington has grown
						into a family nursery known for container-grown shade and ornamental trees.
					</p>
					<p>
						Most of our trees are grown in containers with a bark mix, which makes them lighter
						and easier to plant through the season. We also grow conifers at our location in the
						Willamette Valley, where the climate suits them especially well.
					</p>
					<p>
						Whether you shop online or visit the farm, our goal is the same: trees that leave in
						strong condition and establish well in your yard.
					</p>
					<div class="about-story__actions">
						<a class="btn btn--primary" href={SHOP_URL} rel="noopener noreferrer">Shop Trees</a>
						<a class="btn btn--outline" href="/contact">Contact Us</a>
						<a class="btn btn--outline" href="/20-years">Our 20-year story</a>
					</div>
				</div>
				<figure class="about-story__figure reveal">
					<Image
						src={familyImage}
						alt="Everett and Sandra among blossoming trees at the nursery"
						widths={[600, 900]}
						sizes="(max-width: 900px) 100vw, 40vw"
						quality={80}
						class="about-story__img"
						loading="lazy"
					/>
				</figure>
			</div>
		</section>
		
		<Reviews />
	</main>
	<SiteFooter />
</Layout>

<style>
	.about-hero__inner,
	.about-story__inner {
		display: grid;
		gap: var(--space-lg);
		align-items: center;
	}

	@media (min-width: 900px) {
		.about-hero__inner,
		.about-story__inner {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-xl);
		}
	}

	.about-hero h1 {
		font-size: clamp(2.25rem, 5vw, 3.25rem);
		max-width: 14ch;
	}

	.about-hero__figure,
	.about-story__figure {
		margin: 0;
		overflow: hidden;
	}

	.about-hero__img,
	.about-story__img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.about-story {
		padding-top: 0;
	}

	.about-story__copy p {
		color: var(--text-muted);
	}

	.about-story__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-md);
	}
</style>
