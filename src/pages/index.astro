---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HomeHero from '../components/HomeHero.astro';
import WhatWeGrow from '../components/WhatWeGrow.astro';
import PlantingSeason from '../components/PlantingSeason.astro';
import HowToBuy from '../components/HowToBuy.astro';
import GalleryTeaser from '../components/GalleryTeaser.astro';
import AnniversaryTeaser from '../components/AnniversaryTeaser.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
import { SITE_ORIGIN } from '../constants/site';
import Reviews from '../components/Reviews.astro';
import Sale from '../components/Sale.astro';
---

<Layout
	title="Plant Nursery in Pasco & Tri-Cities WA | Garden Gate Nursery"
	description="Looking for a plant nursery near you in the Tri-Cities? Garden Gate is a Pasco nursery growing shade and ornamental trees for local homeowners. Shop online or schedule a visit."
>
	<LocalBusinessJsonLd pageUrl={SITE_ORIGIN} />
	<div class="home-top">
		<SiteHeader variant="overlay" />
		<HomeHero />
	</div>
	<main>
		<WhatWeGrow />
		<PlantingSeason />
		<HowToBuy />
		<Sale/>
		<GalleryTeaser />
		<AnniversaryTeaser />
		<Reviews />
		<Sale/>
	</main>
	<SiteFooter />
</Layout>

<style>
	.home-top {
		position: relative;
	}
</style>
