---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import heroImage from '../assets/hero/autumn-tunnel.jpg';
---

<header class="hero">
	<div class="hero__content">
		<Image
			src={logo}
			alt="Garden Gate Nursery"
			width={220}
			densities={[1, 2]}
			quality={90}
			loading="eager"
			class="hero__logo"
		/>
		<p class="hero__years">Twenty Years · Since 2006</p>
		<h1 class="hero__title">20 years of growing trees for the Pacific Northwest</h1>
		<p class="hero__tagline">
			<em>Meet you at the Garden Gate?</em> From three rows in Eastern Washington to over 70,000
			trees grown for customers across the PNW and beyond.
		</p>
		<div class="hero__actions">
			<a class="btn btn--primary" href="#story">Our Story</a>
			<a class="btn btn--outline" href="https://www.gardengatetrees.com/" rel="noopener noreferrer"
				>Shop Trees</a
			>
		</div>
	</div>

	<div class="hero__media">
		<Image
			src={heroImage}
			alt="Looking down a path between rows of maple trees in brilliant red and orange fall color"
			widths={[720, 1080, 1440, 1920]}
			sizes="(max-width: 900px) 100vw, 58vw"
			quality={80}
			loading="eager"
			fetchpriority="high"
			class="hero__image"
		/>
	</div>
</header>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		overflow: hidden;
		color: var(--navy);
	}

	.hero__media {
		position: relative;
		min-height: 48svh;
		overflow: hidden;
	}

	.hero__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		animation: hero-ken 18s ease-out forwards;
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: var(--space-lg) var(--space-sm);
		animation: hero-fade 1.1s ease-out both;
	}

	.hero__logo {
		width: clamp(7.5rem, 22vw, 11rem);
		height: auto;
		margin-bottom: var(--space-md);
	}

	.hero__years {
		margin: 0 0 var(--space-xs);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--hill-teal);
	}

	.hero__title {
		max-width: 18ch;
		margin: 0 0 var(--space-sm);
		font-size: clamp(2.1rem, 5.5vw, 3.5rem);
		color: var(--navy);
	}

	.hero__tagline {
		max-width: 34rem;
		margin: 0 0 var(--space-md);
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.55;
		color: var(--text-muted);
	}

	.hero__tagline em {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--hill-teal);
		padding-right: 5px;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	@keyframes hero-ken {
		from {
			transform: scale(1.06);
		}
		to {
			transform: scale(1);
		}
	}

	@keyframes hero-fade {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__image,
		.hero__content {
			animation: none;
		}
	}

	@media (min-width: 900px) {
		.hero {
			grid-template-columns: minmax(20rem, 0.85fr) 1.15fr;
			grid-template-areas: 'content media';
			min-height: 100svh;
		}

		.hero__media {
			grid-area: media;
			min-height: 100svh;
		}

		.hero__content {
			grid-area: content;
			padding: var(--space-xl) clamp(1.5rem, 4vw, 3.5rem);
		}
	}
</style>
