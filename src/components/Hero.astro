---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import heroImage from '../assets/hero/autumn-rows.jpg';
---

<header class="hero">
	<div class="hero__media">
		<Image
			src={heroImage}
			alt="Long rows of container trees in autumn color at Garden Gate Nursery"
			widths={[720, 1080, 1440, 1920]}
			sizes="100vw"
			quality={80}
			loading="eager"
			fetchpriority="high"
			class="hero__image"
		/>
		<div class="hero__veil" aria-hidden="true"></div>
	</div>

	<div class="hero__content">
		<Image
			src={logo}
			alt="Garden Gate Nursery"
			width={220}
			densities={[1, 2]}
			quality={90}
			loading="eager"
			class="hero__logo"
		/>
		<p class="hero__years">Twenty Years · Since 2006</p>
		<h1 class="hero__title">20 years of growing trees for the Pacific Northwest</h1>
		<p class="hero__tagline">
			<em>Meet you at the Garden Gate?</em> From three rows in Eastern Washington to over 70,000
			trees grown for customers across the PNW and beyond.
		</p>
		<div class="hero__actions">
			<a class="btn btn--primary" href="#story">Our Story</a>
			<a class="btn btn--ghost" href="https://www.gardengatetrees.com/" rel="noopener noreferrer"
				>Shop Trees</a
			>
		</div>
	</div>
</header>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		display: grid;
		align-items: end;
		overflow: hidden;
		color: var(--cream);
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		animation: hero- ken 18s ease-out forwards;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(15, 26, 42, 0.35) 0%, rgba(15, 26, 42, 0.15) 35%, rgba(15, 26, 42, 0.72) 78%, rgba(15, 26, 42, 0.88) 100%),
			linear-gradient(90deg, rgba(15, 26, 42, 0.45) 0%, transparent 55%);
	}

	.hero__content {
		position: relative;
		z-index: 1;
		width: min(100% - 2rem, var(--max-width));
		margin: 0 auto;
		padding: var(--space-xl) 0 var(--space-lg);
		animation: hero-fade 1.1s ease-out both;
	}

	.hero__logo {
		width: clamp(7.5rem, 18vw, 11rem);
		height: auto;
		margin-bottom: var(--space-md);
		filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.35));
	}

	.hero__years {
		margin: 0 0 var(--space-xs);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--sun);
	}

	.hero__title {
		max-width: 18ch;
		margin: 0 0 var(--space-sm);
		font-size: clamp(2.35rem, 6vw, 3.75rem);
		color: var(--cream);
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
	}

	.hero__tagline {
		max-width: 34rem;
		margin: 0 0 var(--space-md);
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.55;
		color: rgba(243, 236, 216, 0.92);
	}

	.hero__tagline em {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--sun);
		padding-right: 5px;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	@keyframes hero-ken {
		from {
			transform: scale(1.06);
		}
		to {
			transform: scale(1);
		}
	}

	@keyframes hero-fade {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__image,
		.hero__content {
			animation: none;
		}
	}

	@media (max-width: 640px) {
		.hero {
			align-items: end;
			min-height: 92svh;
		}

		.hero__content {
			padding-bottom: var(--space-md);
		}
	}
</style>
