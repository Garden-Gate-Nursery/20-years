---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import { SHOP_URL, navLinks } from '../constants/site';

interface Props {
	currentPath?: string;
	variant?: 'default' | 'overlay';
}

const { currentPath = Astro.url.pathname, variant = 'default' } = Astro.props;

const isActive = (href: string) => {
	if (href === '/') return currentPath === '/';
	return currentPath === href || currentPath.startsWith(`${href}/`);
};

const isOverlay = variant === 'overlay';
---

<header
	class:list={['site-header', { 'site-header--overlay': isOverlay }]}
	data-header-overlay={isOverlay ? '' : undefined}
>
	<div class="shell">
		<div class="shell__inner site-header__inner">
			<a class="site-header__brand" href="/">
				<Image
					src={logo}
					alt="Garden Gate Nursery"
					width={140}
					densities={[1, 2]}
					quality={90}
					class="site-header__logo"
				/>
				<span class="site-header__brand-text">
					<span class="site-header__name">Garden Gate Nursery</span>
					<span class="site-header__locale">Tri-Cities, WA</span>
				</span>
			</a>

			<button
				type="button"
				class="site-header__toggle"
				aria-expanded="false"
				aria-controls="site-nav"
				data-nav-toggle
			>
				<span class="visually-hidden">Menu</span>
				<span class="site-header__toggle-bars" aria-hidden="true"></span>
			</button>

			<nav class="site-header__nav" id="site-nav" aria-label="Main">
				{
					navLinks.map((link) => (
						<a
							href={link.href}
							class:list={['site-header__link', { 'is-active': isActive(link.href) }]}
							aria-current={isActive(link.href) ? 'page' : undefined}
						>
							{link.label}
						</a>
					))
				}
				<a
					class="site-header__link site-header__shop btn btn--primary"
					href={SHOP_URL}
					rel="noopener noreferrer"
				>
					Shop Trees
				</a>
			</nav>
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector('[data-nav-toggle]');
	const nav = document.getElementById('site-nav');

	if (toggle instanceof HTMLButtonElement && nav) {
		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!open));
			nav.classList.toggle('is-open', !open);
		});
	}

	const overlayHeader = document.querySelector('[data-header-overlay]');
	if (overlayHeader instanceof HTMLElement) {
		const updateScrolled = () => {
			overlayHeader.classList.toggle('is-scrolled', window.scrollY > 80);
		};
		updateScrolled();
		window.addEventListener('scroll', updateScrolled, { passive: true });
	}
</script>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: rgba(250, 246, 238, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(26, 43, 68, 0.08);
		transition:
			background-color 0.25s ease,
			border-color 0.25s ease,
			backdrop-filter 0.25s ease;
	}

	.site-header--overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		background: transparent;
		backdrop-filter: none;
		border-bottom-color: transparent;
	}

	.site-header--overlay.is-scrolled {
		position: fixed;
		background: rgba(250, 246, 238, 0.92);
		backdrop-filter: blur(10px);
		border-bottom-color: rgba(26, 43, 68, 0.08);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		padding-block: 0.75rem;
		position: relative;
	}

	.site-header__brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: var(--navy);
		min-width: 0;
	}

	.site-header__logo {
		width: 3.25rem;
		height: auto;
		flex-shrink: 0;
	}

	.site-header__brand-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.site-header__name {
		font-family: var(--font-display);
		font-weight: 550;
		font-size: 1.05rem;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.site-header__locale {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--hill-teal);
	}

	.site-header__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 2px solid var(--navy);
		background: transparent;
		cursor: pointer;
	}

	.site-header__toggle-bars,
	.site-header__toggle-bars::before,
	.site-header__toggle-bars::after {
		display: block;
		width: 1.15rem;
		height: 2px;
		background: var(--navy);
		position: relative;
	}

	.site-header__toggle-bars::before,
	.site-header__toggle-bars::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.site-header__toggle-bars::before {
		top: -6px;
	}

	.site-header__toggle-bars::after {
		top: 6px;
	}

	.site-header__nav {
		display: none;
		flex-direction: column;
		gap: 0.35rem;
		position: absolute;
		left: calc(-1 * var(--space-md));
		right: calc(-1 * var(--space-md));
		top: 100%;
		padding: var(--space-sm) var(--space-md) var(--space-md);
		background: var(--cream-soft);
		border-bottom: 1px solid rgba(26, 43, 68, 0.08);
	}

	.site-header__nav.is-open {
		display: flex;
	}

	.site-header__link {
		font-weight: 500;
		font-size: 0.9rem;
		text-decoration: none;
		color: var(--navy);
		padding: 0.65rem 0.35rem;
	}

	.site-header__link:hover,
	.site-header__link.is-active {
		color: var(--hill-teal);
	}

	.site-header__shop {
		margin-top: 0.35rem;
		text-align: center;
		padding: 0.75rem 1.25rem;
		font-weight: 600;
		font-size: 1rem;
	}

	.site-header__shop:hover {
		color: var(--navy-deep);
	}

	/* Overlay (transparent over hero) */
	.site-header--overlay:not(.is-scrolled) .site-header__brand {
		color: var(--cream);
	}

	.site-header--overlay:not(.is-scrolled) .site-header__locale {
		color: var(--sun);
	}

	.site-header--overlay:not(.is-scrolled) .site-header__link {
		color: var(--cream);
	}

	.site-header--overlay:not(.is-scrolled) .site-header__link:hover,
	.site-header--overlay:not(.is-scrolled) .site-header__link.is-active {
		color: var(--sun);
	}

	.site-header--overlay:not(.is-scrolled) .site-header__shop {
		color: var(--navy-deep);
	}

	.site-header--overlay:not(.is-scrolled) .site-header__shop:hover {
		color: var(--navy-deep);
	}

	.site-header--overlay:not(.is-scrolled) .site-header__toggle {
		border-color: rgba(243, 236, 216, 0.85);
	}

	.site-header--overlay:not(.is-scrolled) .site-header__toggle-bars,
	.site-header--overlay:not(.is-scrolled) .site-header__toggle-bars::before,
	.site-header--overlay:not(.is-scrolled) .site-header__toggle-bars::after {
		background: var(--cream);
	}

	.site-header--overlay:not(.is-scrolled) .site-header__nav {
		background: rgba(15, 26, 42, 0.92);
		border-bottom-color: rgba(243, 236, 216, 0.12);
	}

	@media (min-width: 800px) {
		.site-header__toggle {
			display: none;
		}

		.site-header__nav {
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 0.25rem 1.15rem;
			position: static;
			left: auto;
			right: auto;
			padding: 0;
			background: transparent;
			border: none;
		}

		.site-header--overlay:not(.is-scrolled) .site-header__nav {
			background: transparent;
			border: none;
		}

		.site-header__link {
			padding: 0.35rem;
		}

		.site-header__shop {
			margin-top: 0;
			margin-left: 0.5rem;
		}
	}
</style>
