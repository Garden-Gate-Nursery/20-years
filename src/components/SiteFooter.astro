---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import { cities } from '../data/cities';
import { SHOP_URL, SITE_ADDRESS, SITE_PHONE, SITE_PHONE_TEL, navLinks } from '../constants/site';

const links = [
	...navLinks,
	{ href: '/20-years', label: '20 Years' },
	{ href: SHOP_URL, label: 'Shop Trees', external: true },
];
---

<footer class="footer">
	<div class="footer__inner">
		<div class="footer__brand">
			<Image src={logo} alt="Garden Gate Nursery" width={96} densities={[1, 2]} quality={85} class="footer__logo" />
			<p class="footer__slogan"><em>Meet you at the Garden Gate!</em></p>
			<p class="footer__locales">Pasco, Washington · Tri-Cities</p>
			<p class="footer__address">{SITE_ADDRESS.line}</p>
			<p class="footer__phone">
				<a href={`tel:${SITE_PHONE_TEL}`}>{SITE_PHONE}</a>
			</p>
		</div>
		<nav class="footer__nav" aria-label="Site">
			{
				links.map((link) => (
					<a
						href={link.href}
						rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>
		<nav class="footer__nav footer__cities" aria-label="Serving Tri-Cities">
			<p class="footer__nav-label">Serving Tri-Cities</p>
			{
				cities.map((city) => (
					<a href={`/${city.slug}`}>
						{city.name}, WA
					</a>
				))
			}
		</nav>
	</div>
	<p class="footer__copy">© {new Date().getFullYear()} Garden Gate Nursery LLC. All rights reserved.</p>
</footer>

<style>
	.footer {
		background: var(--navy-deep);
		color: rgba(243, 236, 216, 0.85);
		padding: var(--space-xl) var(--space-md) var(--space-lg);
	}

	.footer__inner {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-lg);
		justify-content: space-between;
		align-items: flex-start;
		font-size: 0.9rem;
		font-weight: 500;
	}

	.footer__logo {
		width: 5.5rem;
		height: auto;
		margin-bottom: var(--space-sm);
	}

	.footer__slogan {
		margin: 0 0 0.35rem;
		font-size: 1.15rem;
		color: var(--cream);
	}

	.footer__slogan em {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--sun);
	}

	.footer__locales,
	.footer__address,
	.footer__phone {
		margin: 0;
		font-size: 0.95rem;
	}

	.footer__address {
		margin-top: 0.25rem;
	}

	.footer a {
		color: var(--cream);
		text-decoration: none;
	}

	.footer a:hover {
		color: var(--sun);
	}

	.footer__nav {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		font-weight: 600;
	}

	.footer__nav-label {
		margin: 0 0 0.15rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sun);
	}

	.footer__copy {
		max-width: var(--max-width);
		margin: var(--space-lg) auto 0;
		padding-top: var(--space-md);
		border-top: 1px solid rgba(243, 236, 216, 0.15);
		font-size: 0.85rem;
		color: rgba(243, 236, 216, 0.55);
	}
</style>
