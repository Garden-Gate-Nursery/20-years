---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero/autumn-tunnel.jpg';
import { SHOP_URL } from '../constants/site';
---

<header class="home-hero">
	<div class="home-hero__media">
		<Image
			src={heroImage}
			alt="Looking down a path between rows of maple trees in brilliant red and orange fall color"
			widths={[720, 1080, 1440, 1920]}
			sizes="100vw"
			quality={80}
			loading="eager"
			fetchpriority="high"
			class="home-hero__image"
		/>
		<div class="home-hero__shade" aria-hidden="true"></div>
	</div>

	<div class="shell home-hero__shell">
		<div class="shell__inner home-hero__content">
			<p class="home-hero__eyebrow">Tri-Cities, Washington</p>
			<h1 class="home-hero__title">Trees for your Tri-Cities yard</h1>
			<p class="home-hero__lead">
				Garden Gate is a plant nursery in Pasco growing high-quality shade and ornamental trees for
				Tri-Cities yards — large, container-grown trees ready to plant in spring or fall.
			</p>
			<div class="home-hero__actions">
				<a class="btn btn--primary" href={SHOP_URL} rel="noopener noreferrer">Shop Trees</a>
				<a class="btn btn--outline home-hero__btn-outline" href="/contact">Contact Us</a>
			</div>
		</div>
	</div>
</header>

<style>
	.home-hero {
		position: relative;
		min-height: min(100svh, 52rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: hidden;
		color: var(--cream);
	}

	.home-hero__media {
		position: absolute;
		inset: 0;
	}

	.home-hero__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		animation: home-hero-ken 18s ease-out forwards;
	}

	.home-hero__shade {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 80% 70% at 50% 45%, rgba(15, 26, 42, 0.35), transparent 70%),
			linear-gradient(180deg, rgba(15, 26, 42, 0.35) 0%, rgba(15, 26, 42, 0.55) 55%, rgba(15, 26, 42, 0.72) 100%);
	}

	.home-hero__shell {
		position: relative;
		z-index: 1;
		width: 100%;
		align-self: stretch;
		box-sizing: border-box;
	}

	.home-hero__content {
		display: flex;
		flex-direction: column;
		padding-block: var(--space-xl);
		animation: home-hero-fade 1.1s ease-out both;
	}

	.home-hero__content {
		padding-top: calc(var(--space-xl) + var(--space-lg));
		padding-bottom: var(--space-md);
	}

	.home-hero__eyebrow {
		margin: 0 0 var(--space-xs);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--sun);
	}

	.home-hero__title {
		max-width: 14ch;
		margin: 0 0 var(--space-sm);
		font-size: clamp(2.4rem, 6vw, 4rem);
		color: var(--cream);
	}

	.home-hero__lead {
		max-width: 34rem;
		margin: 0 0 var(--space-md);
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.55;
		color: rgba(243, 236, 216, 0.9);
	}

	.home-hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: left;
		gap: 0.75rem;
	}

	.home-hero__btn-outline {
		color: var(--cream);
		border-color: rgba(243, 236, 216, 0.75);
	}

	.home-hero__btn-outline:hover {
		background: var(--cream);
		color: var(--navy);
		border-color: var(--cream);
	}

	@keyframes home-hero-ken {
		from {
			transform: scale(1.06);
		}
		to {
			transform: scale(1);
		}
	}

	@keyframes home-hero-fade {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero__image,
		.home-hero__content {
			animation: none;
		}
	}
</style>
