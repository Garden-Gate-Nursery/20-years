---
import { Image } from 'astro:assets';
import kidsCart from '../assets/story/kids-golf-cart.jpg';
import fallGardenGate from '../assets/story/fall-garden-gate.jpg';
import everettSandra from '../assets/story/everett-sandra-foreheads.jpg';
import { story2006Featured, story2006Photos } from '../data/story-2006';
import { story2007Featured, story2007Photos } from '../data/story-2007';
import { story2008Featured, story2008Photos } from '../data/story-2008';
import { story2011Featured, story2011Photos } from '../data/story-2011';
import { story2014Featured, story2014Photos } from '../data/story-2014';
import { storyTodayFeatured, storyTodayPhotos } from '../data/story-today';
---

<section id="story" class="section story">
	<div class="section__inner">
		<div class="story__intro reveal">
			<p class="section__eyebrow">Our Story</p>
			<h2>From a dream on the road to rows that stretch for miles</h2>
			<p class="section__lead">
				Garden Gate Nursery began with Everett and Sandra, and a slogan that still greets every
				visitor.
			</p>
		</div>

		<div class="story__timeline">
			<article class="story__beat reveal">
				<p class="story__year">1985</p>
				<div class="story__copy">
					<h3>Kansas roots, Washington horizons</h3>
					<p>
						Everett and Sandra came from Kansas after years managing their family dairy farm through
						hard financial times. In Washington they farmed hay, and kept dreaming of what might
						grow next.
					</p>
				</div>
			</article>

			<article class="story__beat story__beat--photo reveal">
				<p class="story__year">Early 2000s</p>
				<div class="story__copy">
					<h3>Named on a drive</h3>
					<p>
						Their son Chris remembers Everett and Sandra dreaming up a nursery while driving. They
						landed on the name Garden Gate Nursery, and Everett shared the slogan with Sandra:
						<em> “Meet you at the Garden Gate!”</em>
					</p>
				</div>
				<figure class="story__figure">
					<Image
						src={everettSandra}
						alt="Everett and Sandra holding hands and smiling at each other in the nursery"
						widths={[480, 720, 960]}
						sizes="(max-width: 800px) 100vw, 420px"
						quality={80}
						class="story__img"
						style="object-position: top"
					/>
					<figcaption>Everett &amp; Sandra</figcaption>
				</figure>
			</article>

			<article class="story__beat reveal">
				<p class="story__year">2005</p>
				<div class="story__copy">
					<h3>Three rows in the ground</h3>
					<p>
						We planted three rows of trees and began the long learning curve of growing high-quality
						container trees in Eastern Washington: trial, error, and care, season after season.
					</p>
				</div>
			</article>

			<article class="story__beat story__beat--photo reveal">
				<p class="story__year">July 2006</p>
				<div class="story__copy">
					<h3>First order shipped</h3>
					<p>
						The nursery sold its first order, the start of serving landscapers, retailers, cities,
						and homeowners across the Pacific Northwest. We also plant 3 acres of pot-in-pot container trees. The whole family pitches in.
					</p>
				</div>
				<figure class="story__figure">
					<Image
						src={story2006Featured.src}
						alt={story2006Featured.alt}
						widths={[480, 720, 960]}
						sizes="(max-width: 800px) 100vw, 420px"
						quality={80}
						class="story__img"
					/>
					<figcaption>
						{story2006Featured.caption}
						<button
							type="button"
							class="story__more-photos"
							data-story-2006-open
							aria-haspopup="dialog"
							aria-controls="story-2006-dialog"
						>
							View more photos
						</button>
					</figcaption>
				</figure>
			</article>

			<article class="story__beat story__beat--photo story__beat--photo-left reveal">
				<p class="story__year">2007</p>
				<div class="story__copy">
					<h3>A family business</h3>
					<p>
						Grandkids, siblings, and grandparents all pitch in—planting, shipping, and growing
						together, with lot's of dining room table meetings.
					</p>
				</div>
				<figure class="story__figure">
					<Image
						src={story2007Featured.src}
						alt={story2007Featured.alt}
						widths={[480, 720, 960]}
						sizes="(max-width: 800px) 100vw, 420px"
						quality={80}
						class="story__img"
					/>
					<figcaption>
						{story2007Featured.caption}
						<button
							type="button"
							class="story__more-photos"
							data-story-2007-open
							aria-haspopup="dialog"
							aria-controls="story-2007-dialog"
						>
							View more photos
						</button>
					</figcaption>
				</figure>
			</article>

			<article class="story__beat story__beat--photo reveal">
				<p class="story__year">2008</p>
				<div class="story__copy">
					<h3>A lot of work</h3>
					<p>
						Work continues at the nursery—planting bare-root trees, irrigation, staking, pruning and
						more.
					</p>
				</div>
				<figure class="story__figure">
					<Image
						src={story2008Featured.src}
						alt={story2008Featured.alt}
						widths={[480, 720, 960]}
						sizes="(max-width: 800px) 100vw, 420px"
						quality={80}
						class="story__img"
					/>
					<figcaption>
						{story2008Featured.caption}
						<button
							type="button"
							class="story__more-photos"
							data-story-2008-open
							aria-haspopup="dialog"
							aria-controls="story-2008-dialog"
						>
							View more photos
						</button>
					</figcaption>
				</figure>
			</article>

			<article class="story__beat story__beat--photo story__beat--photo-left reveal">
				<p class="story__year">2011</p>
				<div class="story__copy">
					<h3>Open to the public</h3>
					<p>
						Garden Gate hosts our first open to the public week, inviting Tri-Cities WA customers to
						tour the nursery and pick out large trees.
					</p>
				</div>
				<figure class="story__figure">
					<Image
						src={story2011Featured.src}
						alt={story2011Featured.alt}
						widths={[480, 720, 960]}
						sizes="(max-width: 800px) 100vw, 420px"
						quality={80}
						class="story__img"
					/>
					<figcaption>
						{story2011Featured.caption}
						<button
							type="button"
							class="story__more-photos"
							data-story-2011-open
							aria-haspopup="dialog"
							aria-controls="story-2011-dialog"
						>
							View more photos
						</button>
					</figcaption>
				</figure>
			</article>

			<article class="story__beat story__beat--photo reveal">
				<p class="story__year">2014</p>
				<div class="story__copy">
					<h3>We open our Oregon nursery</h3>
					<p>
						To support our growing demand for conifer tree varieties, we open our Boring, Oregon
						growing location. In the Willamette valley, it's the ideal place to grow evergreen
						varieties.
					</p>
				</div>
				<figure class="story__figure">
					<Image
						src={story2014Featured.src}
						alt={story2014Featured.alt}
						widths={[480, 720, 960]}
						sizes="(max-width: 800px) 100vw, 420px"
						quality={80}
						class="story__img"
					/>
					<figcaption>
						{story2014Featured.caption}
						<button
							type="button"
							class="story__more-photos"
							data-story-2014-open
							aria-haspopup="dialog"
							aria-controls="story-2014-dialog"
						>
							View more photos
						</button>
					</figcaption>
				</figure>
			</article>

			<article class="story__beat story__beat--photo story__beat--photo-left reveal">
				<p class="story__year">Today</p>
				<div class="story__copy">
					<h3>Over 70,000 trees</h3>
					<p>
						Garden Gate has grown into a Tri-Cities company known for container trees shipped
						throughout the PNW and beyond: still family, still local, still glad to meet you at the
						gate.
					</p>
				</div>
				<figure class="story__figure">
					<Image
						src={storyTodayFeatured.src}
						alt={storyTodayFeatured.alt}
						widths={[480, 720, 960]}
						sizes="(max-width: 800px) 100vw, 420px"
						quality={80}
						class="story__img"
					/>
					<figcaption>
						{storyTodayFeatured.caption}
						<button
							type="button"
							class="story__more-photos"
							data-story-today-open
							aria-haspopup="dialog"
							aria-controls="story-today-dialog"
						>
							View more photos
						</button>
					</figcaption>
				</figure>
			</article>
		</div>

		<div class="story__moments reveal">
			<figure class="story__moment">
				<Image
					src={fallGardenGate}
					alt="Rows of maple trees with red and orange autumn leaves at Garden Gate Nursery"
					widths={[400, 600, 800]}
					sizes="(max-width: 700px) 100vw, 50vw"
					quality={80}
					class="story__img"
				/>
				<figcaption>Fall at Garden Gate</figcaption>
			</figure>
			<figure class="story__moment">
				<Image
					src={kidsCart}
					alt="Children smiling on a red golf cart among nursery tree rows"
					widths={[400, 600, 800]}
					sizes="(max-width: 700px) 100vw, 50vw"
					quality={80}
					class="story__img"
				/>
				<figcaption>Rachel and her crew</figcaption>
			</figure>
		</div>
	</div>

	<dialog class="story__dialog" id="story-2006-dialog" aria-label="2006 nursery photos">
		<form method="dialog" class="story__dialog-bar">
			<button type="submit" class="story__dialog-close" aria-label="Close">Close</button>
		</form>
		<div class="story__dialog-grid">
			{
				story2006Photos.map((item) => (
					<figure class="story__dialog-item">
						<Image
							src={item.src}
							alt={item.alt}
							widths={[480, 720, 960]}
							sizes="(max-width: 700px) 90vw, 280px"
							quality={80}
							class="story__dialog-img"
							loading="lazy"
							style={item.objectPosition ? `object-position: ${item.objectPosition}` : undefined}
						/>
					</figure>
				))
			}
		</div>
	</dialog>

	<dialog class="story__dialog" id="story-2007-dialog" aria-label="2007 nursery photos">
		<form method="dialog" class="story__dialog-bar">
			<button type="submit" class="story__dialog-close" aria-label="Close">Close</button>
		</form>
		<div class="story__dialog-grid">
			{
				story2007Photos.map((item) => (
					<figure class="story__dialog-item">
						<Image
							src={item.src}
							alt={item.alt}
							widths={[480, 720, 960]}
							sizes="(max-width: 700px) 90vw, 280px"
							quality={80}
							class="story__dialog-img"
							loading="lazy"
							style={item.objectPosition ? `object-position: ${item.objectPosition}` : undefined}
						/>
					</figure>
				))
			}
		</div>
	</dialog>

	<dialog class="story__dialog" id="story-2008-dialog" aria-label="2008 nursery photos">
		<form method="dialog" class="story__dialog-bar">
			<button type="submit" class="story__dialog-close" aria-label="Close">Close</button>
		</form>
		<div class="story__dialog-grid">
			{
				story2008Photos.map((item) => (
					<figure class="story__dialog-item">
						<Image
							src={item.src}
							alt={item.alt}
							widths={[480, 720, 960]}
							sizes="(max-width: 700px) 90vw, 280px"
							quality={80}
							class="story__dialog-img"
							loading="lazy"
							style={item.objectPosition ? `object-position: ${item.objectPosition}` : undefined}
						/>
					</figure>
				))
			}
		</div>
	</dialog>

	<dialog class="story__dialog" id="story-2011-dialog" aria-label="2011 nursery photos">
		<form method="dialog" class="story__dialog-bar">
			<button type="submit" class="story__dialog-close" aria-label="Close">Close</button>
		</form>
		<div class="story__dialog-grid">
			{
				story2011Photos.map((item) => (
					<figure class="story__dialog-item">
						<Image
							src={item.src}
							alt={item.alt}
							widths={[480, 720, 960]}
							sizes="(max-width: 700px) 90vw, 280px"
							quality={80}
							class="story__dialog-img"
							loading="lazy"
							style={item.objectPosition ? `object-position: ${item.objectPosition}` : undefined}
						/>
					</figure>
				))
			}
		</div>
	</dialog>

	<dialog class="story__dialog" id="story-2014-dialog" aria-label="2014 Oregon nursery photos">
		<form method="dialog" class="story__dialog-bar">
			<button type="submit" class="story__dialog-close" aria-label="Close">Close</button>
		</form>
		<div class="story__dialog-grid">
			{
				story2014Photos.map((item) => (
					<figure class="story__dialog-item">
						<Image
							src={item.src}
							alt={item.alt}
							widths={[480, 720, 960]}
							sizes="(max-width: 700px) 90vw, 280px"
							quality={80}
							class="story__dialog-img"
							loading="lazy"
							style={item.objectPosition ? `object-position: ${item.objectPosition}` : undefined}
						/>
					</figure>
				))
			}
		</div>
	</dialog>

	<dialog class="story__dialog" id="story-today-dialog" aria-label="Today nursery photos">
		<form method="dialog" class="story__dialog-bar">
			<button type="submit" class="story__dialog-close" aria-label="Close">Close</button>
		</form>
		<div class="story__dialog-grid">
			{
				storyTodayPhotos.map((item) => (
					<figure class="story__dialog-item">
						<Image
							src={item.src}
							alt={item.alt}
							widths={[480, 720, 960]}
							sizes="(max-width: 700px) 90vw, 280px"
							quality={80}
							class="story__dialog-img"
							loading="lazy"
							style={item.objectPosition ? `object-position: ${item.objectPosition}` : undefined}
						/>
					</figure>
				))
			}
		</div>
	</dialog>
</section>

<script>
	const storyDialogs = [
		{ open: '[data-story-2006-open]', dialog: 'story-2006-dialog' },
		{ open: '[data-story-2007-open]', dialog: 'story-2007-dialog' },
		{ open: '[data-story-2008-open]', dialog: 'story-2008-dialog' },
		{ open: '[data-story-2011-open]', dialog: 'story-2011-dialog' },
		{ open: '[data-story-2014-open]', dialog: 'story-2014-dialog' },
		{ open: '[data-story-today-open]', dialog: 'story-today-dialog' },
	] as const;

	for (const { open, dialog: dialogId } of storyDialogs) {
		const openBtn = document.querySelector(open) as HTMLButtonElement | null;
		const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
		if (!openBtn || !dialog) continue;
		openBtn.addEventListener('click', () => dialog.showModal());
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	}
</script>

<style>
	.story {
		padding-top: var(--space-2xl);
	}

	.story__intro {
		max-width: 40rem;
		margin-bottom: var(--space-xl);
	}

	.story__timeline {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
		position: relative;
		padding-left: 0;
	}

	.story__timeline::before {
		content: '';
		position: absolute;
		left: 0.35rem;
		top: 0.35rem;
		bottom: 0.35rem;
		width: 2px;
		background: linear-gradient(180deg, var(--sun), var(--hill-teal), var(--soil-light));
		opacity: 0.55;
	}

	@media (min-width: 800px) {
		.story__timeline::before {
			left: 5.5rem;
		}
	}

	.story__beat {
		display: grid;
		gap: var(--space-sm);
		padding-left: 1.75rem;
		position: relative;
	}

	.story__beat::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.45rem;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background: var(--sun);
		border: 2px solid var(--navy);
		box-shadow: 0 0 0 3px rgba(240, 213, 106, 0.35);
	}

	@media (min-width: 800px) {
		.story__beat {
			grid-template-columns: 5rem 1fr;
			padding-left: 0;
			column-gap: var(--space-md);
		}

		.story__beat::before {
			left: 5.2rem;
		}

		.story__beat--photo {
			grid-template-columns: 5rem 1fr minmax(240px, 420px);
			align-items: start;
		}

		.story__beat--photo-left .story__figure {
			order: 2;
		}

		.story__beat--photo-left .story__copy {
			order: 3;
		}
	}

	.story__year {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 650;
		color: var(--ray-orange);
	}

	.story__copy h3 {
		margin-bottom: 0.4rem;
	}

	.story__copy em {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--hill-teal);
	}

	.story__figure,
	.story__moment {
		margin: 0;
	}

	.story__img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		box-shadow: var(--shadow-soft);
	}

	.story__figure figcaption,
	.story__moment figcaption {
		margin-top: 0.5rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.story__figure figcaption {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45rem;
	}

	.story__more-photos {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--hill-teal);
		background: transparent;
		border: none;
		padding: 0;
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.story__more-photos:hover,
	.story__more-photos:focus-visible {
		color: var(--navy);
	}

	.story__moments {
		display: grid;
		gap: var(--space-md);
		margin-top: var(--space-xl);
	}

	@media (min-width: 700px) {
		.story__moments {
			grid-template-columns: 1fr 1fr;
		}
	}

	.story__dialog {
		border: none;
		padding: 0;
		max-width: min(94vw, 56rem);
		max-height: min(90vh, 48rem);
		background: var(--navy-deep);
		color: var(--cream);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
	}

	.story__dialog::backdrop {
		background: rgba(15, 26, 42, 0.72);
	}

	.story__dialog-bar {
		display: flex;
		justify-content: flex-end;
		padding: 0.5rem 0.75rem;
		position: sticky;
		top: 0;
		background: var(--navy-deep);
		z-index: 1;
	}

	.story__dialog-close {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--cream);
		background: transparent;
		border: 1px solid rgba(243, 236, 216, 0.35);
		padding: 0.4rem 0.75rem;
		cursor: pointer;
	}

	.story__dialog-close:hover {
		border-color: var(--sun);
		color: var(--sun);
	}

	.story__dialog-grid {
		display: grid;
		gap: 0.75rem;
		padding: 0 0.75rem 1rem;
		grid-template-columns: 1fr;
		overflow: auto;
		max-height: calc(min(90vh, 48rem) - 3rem);
	}

	@media (min-width: 600px) {
		.story__dialog-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (min-width: 900px) {
		.story__dialog-grid {
			grid-template-columns: 1fr 1fr 1fr;
		}
	}

	.story__dialog-item {
		margin: 0;
	}

	.story__dialog-img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
	}

</style>
